this.tick = function(game) {
  if ( game.step % 30 == 0 ) {
    for (let ship of game.ships) {
      if (!ship.custom.buttons_installed && ship.alive)
      {
        ship.custom.buttons_installed = true;
        for (b in buttons)
        {
          ship.setUIComponent(buttons[b]);
          ship.custom.tree = 0;
          for (let tree = 0; tree < ship_list.length; tree++) {
            if (ship_list[tree].indexOf(ship.type) >= 0) {
              ship.custom.tree = tree;
              break;
            }
          }
        }
      }
    }
    // for ( var a = 0 ; a < game.ships.length ; a++ ) {
      // var admin = game.ships[0];
      // if(!admin.custom.god_button_installed) {
        // admin.custom.god_button_installed = true;
        // admin.setUIComponent(god_button);
      // }
    // }
  }
  var a = {
    from: 1,
    to: 100
  };
  var b = {
    from: 107,
    to: 200
  };
  var tier7 = [a,b];
  for (let ship of game.ships) {
    if (ship.stats == 0 && [tier7].includes(ship.type)) {
      ship.set({stats: 10000000});
    }
  }
};



this.event = function(event, game) {
  switch (event.name)
  {
    case "ship_destroyed":
      if (event.killer != null)
      {
        event.killer.custom.kills = event.killer.custom.kills + 1 || 1;
      }
      break;
    case "ui_component_clicked":
      var ship = event.ship;
      var component = event.id;
      switch (component)
      {
        case "switch":
          var tree = ship.custom.tree;
          var index = -1;
          index = ship_list[tree].indexOf(ship.type);
          if (index >= 0) {
            var new_type;
            var new_stats = 0;
            index = (index + 1) % ship_list[tree].length;
            new_type = ship_list[tree][index];
            if (ship.custom.keep_maxed)
            {
              var max = 88888888;
              if (ship.stats < max) {
                new_stats = 88888888;
              }
            }
            ship.set({type:new_type,stats:new_stats,shield:999});
          }
          break;
        case "stats":
          var stats = ship.stats;
          if (stats < 11111111) {
            ship.custom.keep_maxed = true;
            ship.set({stats:88888888})
          }
          else {
            ship.custom.keep_maxed = false;
            ship.set({stats:00000000})
          }
          break;
        case "reset":
          var new_stats = ship.custom.keep_maxed ? 11111111 : 0;
          ship.set({type:101,stats:new_stats});
          break;
        case "crystals":
          var cargo = 980;
          switch (true) {
            case ship.type >= 701 && ship.type <= 799:
              cargo = 980;
              break;
            case ship.type >= 107 && ship.type <= 200:
              cargo = 980;
              break;
            case ship.type >= 213 && ship.type <= 300:
              cargo = 980;
              break;
            case ship.type >= 325 && ship.type <= 400:
              cargo = 980;
              break;
            case ship.type >= 449 && ship.type <= 500:
              cargo = 980;
              break;
            case ship.type >= 597 && ship.type <= 600:
              cargo = 980;
              break;
            case ship.type >= 101 && ship.type <= 106:
              cargo = 20;
              break;
            case ship.type >= 201 && ship.type <= 212:
              cargo = 80;
              break;
            case ship.type >= 301 && ship.type <= 324:
              cargo = 180;
              break;
            case ship.type >= 401 && ship.type <= 448:
              cargo = 320;
              break;
            case ship.type >= 501 && ship.type <= 596:
              cargo = 500;
              break;  
            case ship.type >= 601 && ship.type <= 699:
              cargo = 720;
              break; 
          }
          ship.set({crystals:cargo,shield:999});
          break;
        case "team1":
          if (this.options.friendly_colors === 2) {
            ship.set({team:0,hue:0});
          }
          break;
        case "team2":
          if (this.options.friendly_colors === 2) {
            ship.set({team:1,hue:200});
          }
          break;
        case "admin":
          var new_type;
          if (ship.type == 102) {
            new_type = 792;
          } else if (ship.type == 792) {
            new_type = 793;
          } else if (ship.type == 793) {
            new_type = 791;
          } else {
            new_type = 791;
          }
          ship.set({type:new_type});
          break;
      }
      break;
  }
};
